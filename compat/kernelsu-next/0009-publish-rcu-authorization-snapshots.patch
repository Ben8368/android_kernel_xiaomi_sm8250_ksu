+bool ksu_uid_should_umount(uid_t uid)
+{
+	struct perm_data *p;
+	bool result = default_non_root_profile.umount_modules;
+	bool custom = false;
+	if (ksu_is_manager_uid_valid() && ksu_get_manager_uid() == uid)
+		return false;
+	rcu_read_lock();
+	list_for_each_entry_rcu(p, &allow_list, list) {
+		if (!strcmp(p->profile.key, "$") && is_default(&p->profile) && !custom)
+			result = p->profile.nrp_config.profile.umount_modules;
+		if (p->profile.current_uid != uid || is_default(&p->profile))
+			continue;
+		if (p->profile.allow_su) {
+			result = false;
+			custom = true;
+		} else if (!p->profile.nrp_config.use_default) {
+			result = p->profile.nrp_config.profile.umount_modules;
+			custom = true;
+		}
+	}
+	rcu_read_unlock();
+	return result;
+}
