+bool __ksu_is_allow_uid(uid_t uid)
+{
+	struct perm_data *p;
+	bool allowed = false;
+	if (uid == 0)
+		return is_ksu_domain();
+	if (forbid_system_uid(uid) || uid == KSU_APP_PROFILE_PRESERVE_UID)
+		return false;
+	if (ksu_is_manager_uid_valid() && ksu_get_manager_uid() == uid)
+		return true;
+	rcu_read_lock();
+	list_for_each_entry_rcu(p, &allow_list, list) {
+		if (p->profile.current_uid == uid) {
+			allowed = p->profile.allow_su;
+			break;
+		}
+	}
+	rcu_read_unlock();
+	return allowed;
+}
