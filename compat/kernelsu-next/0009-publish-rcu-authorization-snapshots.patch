+/* Called by prctl/LSM and the boot loader worker. Allocation must also be
+ * safe if this interface is wired through a kprobe in another configuration.
+ * Failed allocation/capacity checks leave the previous grant untouched.
+ */
+static bool set_profile(struct app_profile *profile, bool persist, bool loading)
+{
+	struct perm_data *p, *new;
+	unsigned long flags;
+	bool result = false;
+	if (!profile_valid(profile))
+		return false;
+	new = kmalloc(sizeof(*new), GFP_ATOMIC);
+	if (!new)
+		return false;
+	new->profile = *profile;
+	new->retired = false;
+	spin_lock_irqsave(&allowlist_lock, flags);
+	if (allowlist_stopping || (loading && userspace_updated))
+		goto unlock;
+	list_for_each_entry(p, &allow_list, list) {
+		if (p->profile.current_uid != profile->current_uid)
+			continue;
+		if ((is_default(profile) || is_default(&p->profile)) &&
+		    strcmp(profile->key, p->profile.key))
+			continue;
+		write_seqcount_begin(&allowlist_seq);
+		list_replace_rcu(&p->list, &new->list);
+		p->retired = true;
+		if (!loading)
+			userspace_updated = true;
+		write_seqcount_end(&allowlist_seq);
+		call_rcu(&p->rcu, free_profile_rcu);
+		result = true;
+		goto unlock;
+	}
+	if (allowlist_count == KSU_MAX_PROFILES)
+		goto unlock;
+	write_seqcount_begin(&allowlist_seq);
+	list_add_tail_rcu(&new->list, &allow_list);
+	allowlist_count++;
+	if (!loading)
+		userspace_updated = true;
+	write_seqcount_end(&allowlist_seq);
+	result = true;
+unlock:
+	spin_unlock_irqrestore(&allowlist_lock, flags);
+	if (!result)
+		kfree(new);
+	else if (persist)
+		persistent_allow_list();
+	return result;
+}
