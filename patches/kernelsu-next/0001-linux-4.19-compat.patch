diff --git a/kernel/selinux/avtab_compat.h b/kernel/selinux/avtab_compat.h
new file mode 100644
index 00000000..15904df9
--- /dev/null
+++ b/kernel/selinux/avtab_compat.h
@@ -0,0 +1,64 @@
+#ifndef KSU_SELINUX_AVTAB_COMPAT_H
+#define KSU_SELINUX_AVTAB_COMPAT_H
+
+
+/* Linux 4.19 stores bucket heads in flex_array, not a C pointer array. */
+static inline struct avtab_node *ksu_avtab_bucket(struct avtab *table,
+							   unsigned int bucket)
+{
+	if (!table || !table->htable || bucket >= table->nslot)
+		return NULL;
+	return flex_array_get_ptr(table->htable, bucket);
+}
+
+static inline int ksu_avtab_set_bucket(struct avtab *table,
+					       unsigned int bucket,
+					       struct avtab_node *node)
+{
+	if (!table || !table->htable || bucket >= table->nslot)
+		return -EINVAL;
+	return flex_array_put_ptr(table->htable, bucket, node, GFP_KERNEL);
+}
+
+static inline bool ksu_avtab_move_node(struct avtab *table,
+					       struct avtab *removed,
+					       struct avtab_node *target)
+{
+	unsigned int bucket;
+
+	if (!table || !removed || !target || !removed->htable || !removed->nslot)
+		return false;
+
+	for (bucket = 0; bucket < table->nslot; bucket++) {
+		struct avtab_node *prev = NULL;
+		struct avtab_node *node = ksu_avtab_bucket(table, bucket);
+
+		while (node) {
+			if (node == target) {
+				if (ksu_avtab_set_bucket(removed, 0, node))
+					return false;
+				if (!prev && ksu_avtab_set_bucket(table, bucket, node->next)) {
+					ksu_avtab_set_bucket(removed, 0, NULL);
+					return false;
+				}
+				if (prev)
+					prev->next = node->next;
+				if (table->nel)
+					table->nel--;
+				node->next = NULL;
+				removed->nel = 1;
+				return true;
+			}
+			prev = node;
+			node = node->next;
+		}
+	}
+	return false;
+}
+
+#define ksu_avtab_for_each(table, node) \
+	for (unsigned int __bucket = 0; __bucket < (table).nslot; __bucket++) \
+		for ((node) = ksu_avtab_bucket(&(table), __bucket); (node); \
+		     (node) = (node)->next)
+
+#endif
